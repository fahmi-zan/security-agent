### 4. Requirement Schema Template

```json
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprintos.dev/schemas/requirement.schema.json",
  "title": "Requirement",
  "description": "Definition of a requirement.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique requirement identifier.",
      "pattern": "^REQ-\\d+$"
    },
    "title": {
      "type": "string",
      "description": "Requirement title.",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "description": "Requirement description."
    },
    "type": {
      "type": "string",
      "enum": ["functional", "non-functional", "business", "technical", "constraint"]
    },
    "priority": {
      "type": "string",
      "enum": ["must-have", "should-have", "could-have", "won't-have"]
    },
    "source": {
      "type": "string",
      "description": "Requirement source (stakeholder, document, etc.)."
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "approved", "in-development", "implemented", "rejected"]
    },
    "linked_features": {
      "type": "array",
      "description": "Features this requirement maps to.",
      "items": {
        "type": "string"
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "description": "Acceptance criteria for this requirement.",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "description": "Requirements this requirement depends on.",
      "items": {
        "type": "string"
      }
    }
  },
  "required": ["id", "title", "type", "priority", "status"],
  "additionalProperties": false
}
```

### 5. ADR Schema Template

```json
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprintos.dev/schemas/adr.schema.json",
  "title": "ADR",
  "description": "Definition of an Architecture Decision Record.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique ADR identifier.",
      "pattern": "^adr-\\d+$"
    },
    "title": {
      "type": "string",
      "description": "ADR title.",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["proposed", "accepted", "rejected", "deprecated", "superseded"]
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "ADR creation date."
    },
    "context": {
      "type": "string",
      "description": "Context and problem being addressed."
    },
    "decision": {
      "type": "string",
      "description": "The decision made."
    },
    "consequences": {
      "type": "object",
      "properties": {
        "positive": {
          "type": "array",
          "items": { "type": "string" }
        },
        "negative": {
          "type": "array",
          "items": { "type": "string" }
        },
        "neutral": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "description": "Alternatives considered.",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "pros": { "type": "array", "items": { "type": "string" } },
          "cons": { "type": "array", "items": { "type": "string" } },
          "rejected_because": { "type": "string" }
        },
        "required": ["name", "description"]
      }
    },
    "deciders": {
      "type": "array",
      "description": "People who made the decision.",
      "items": { "type": "string" }
    },
    "references": {
      "type": "array",
      "description": "Reference links.",
      "items": { "type": "string" }
    }
  },
  "required": ["id", "title", "status", "date", "context", "decision"],
  "additionalProperties": false
}
```


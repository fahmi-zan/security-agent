## VALIDATION SCRIPT TEMPLATE

**Location:** `.blueprint/validation/validator.js`

**Template:**

```javascript
/**
 * BlueprintOS Validation Engine
 * Validates all artifacts against defined rules.
 */

const fs = require('fs');
const path = require('path');
const glob = require('glob');
const YAML = require('yaml');
const Ajv = require('ajv');

const ROOT = path.resolve(__dirname, '..');
const BLUEPRINT = path.join(ROOT, '.blueprint');

/**
 * Collect all files that need validation.
 */
function collectFiles() {
  const files = {
    markdown: glob.sync('**/*.md', { cwd: BLUEPRINT }),
    json: glob.sync('**/*.json', { cwd: BLUEPRINT }),
    yaml: glob.sync('**/*.{yaml,yml}', { cwd: BLUEPRINT }),
    prompt: glob.sync('**/*.prompt', { cwd: BLUEPRINT }),
  };
  return files;
}

/**
 * Validate YAML front matter.
 */
function validateFrontMatter(content) {
  const required = [
    'id',
    'title',
    'owner',
    'status',
    'version',
    'depends_on',
    'generates',
    'reviewers',
    'last_updated',
    'tags',
  ];
  
  const match = content.match(/^---\n([\s\S]*?)\n---\n/);
  if (!match) {
    return [{ status: 'failed', severity: 'error', message: 'Missing YAML front matter' }];
  }
  
  const frontMatter = YAML.parse(match[1]);
  const errors = [];
  
  for (const field of required) {
    if (!(field in frontMatter)) {
      errors.push({
        status: 'failed',
        severity: 'error',
        message: `Missing required field: ${field}`,
      });
    }
  }
  
  const validStatuses = ['draft', 'in-review', 'active', 'deprecated'];
  if (frontMatter.status && !validStatuses.includes(frontMatter.status)) {
    errors.push({
      status: 'failed',
      severity: 'error',
      message: `Invalid status: ${frontMatter.status}. Valid: ${validStatuses.join(', ')}`,
    });
  }
  
  return errors;
}

/**
 * Validate links in markdown files.
 */
function validateLinks(file, content, results) {
  const linkRegex = /\[([^\]]+)\]\(([^)]+)\)/g;
  let match;
  
  while ((match = linkRegex.exec(content)) !== null) {
    const [, label, target] = match;
    if (target.startsWith('http://') || target.startsWith('https://')) continue;
    if (target.startsWith('#') || target.startsWith('mailto:')) continue;
    
    const targetPath = path.resolve(path.dirname(file), target.replace(/\.md(#.*)?$/, '.md'));
    if (!fs.existsSync(targetPath)) {
      results.push({
        validator: 'links',
        check: 'internal-links-resolve',
        status: 'failed',
        severity: 'error',
        artifact: file,
        message: `Broken link: ${label} → ${target}`,
        suggestion: `Fix link or create target: ${targetPath}`,
      });
    }
  }
}

/**
 * Validate JSON files against schemas.
 */
function validateJSON(file, results) {
  try {
    const data = JSON.parse(fs.readFileSync(file, 'utf8'));
    return data;
  } catch (error) {
    results.push({
      validator: 'json',
      check: 'valid-json',
      status: 'failed',
      severity: 'error',
      artifact: file,
      message: `Invalid JSON: ${error.message}`,
    });
    return null;
  }
}

/**
 * Check for placeholder content.
 */
function validatePlaceholders(file, content, results) {
  const placeholders = [
    { pattern: /\bTODO\b/i, message: 'Contains TODO placeholder' },
    { pattern: /\bTBD\b/i, message: 'Contains TBD placeholder' },
    { pattern: /\bFIXME\b/i, message: 'Contains FIXME placeholder' },
    { pattern: /Lorem ipsum/i, message: 'Contains Lorem ipsum placeholder' },
    { pattern: /\{[a-z_-]+\}/i, message: 'Contains template placeholder' },
  ];
  
  for (const { pattern, message } of placeholders) {
    if (pattern.test(content)) {
      results.push({
        validator: 'markdown',
        check: 'no-placeholder-content',
        status: 'failed',
        severity: 'error',
        artifact: file,
        message,
      });
    }
  }
}

/**
 * Run all validators.
 */
function validate() {
  const results = [];
  const files = collectFiles();
  
  for (const file of files.markdown) {
    const fullPath = path.join(BLUEPRINT, file);
    const content = fs.readFileSync(fullPath, 'utf8');
    validateFrontMatter(content).forEach((error) => {
      results.push({ ...error, artifact: file });
    });
    validateLinks(fullPath, content, results);
    validatePlaceholders(file, content, results);
  }
  
  for (const file of files.json) {
    validateJSON(path.join(BLUEPRINT, file), results);
  }
  
  const summary = summarize(results);
  writeReport(summary, results);
}

/**
 * Summarize validation results.
 */
function summarize(results) {
  const errors = results.filter((r) => r.severity === 'error');
  const warnings = results.filter((r) => r.severity === 'warning');
  
  return {
    total: results.length,
    errors: errors.length,
    warnings: warnings.length,
    passed: results.length - errors.length - warnings.length,
    status: errors.length > 0 ? 'failed' : 'passed',
  };
}

/**
 * Write validation report.
 */
function writeReport(summary, results) {
  const report = {
    report_id: `validation-${Date.now()}`,
    generated_at: new Date().toISOString(),
    summary,
    results,
  };
  
  fs.writeFileSync(
    path.join(BLUEPRINT, 'validation/validation-report.json'),
    JSON.stringify(report, null, 2)
  );
  
  console.log(`\nValidation Complete:`);
  console.log(`  Passed: ${summary.passed}`);
  console.log(`  Errors: ${summary.errors}`);
  console.log(`  Warnings: ${summary.warnings}`);
  console.log(`  Status: ${summary.status.toUpperCase()}`);
  
  if (summary.errors > 0) {
    process.exit(1);
  }
}

// Run validation
validate();
```


{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprintos.dev/schemas/task.schema.json",
  "title": "Task",
  "description": "Definition of a task in the BlueprintOS task system.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string", "description": "Schema reference." },
    "id": {
      "type": "string",
      "pattern": "^TASK-\\d+$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "priority": { "enum": ["critical", "high", "medium", "low"] },
    "owner": { "type": "string" },
    "status": { "enum": ["backlog", "todo", "in-progress", "blocked", "in-review", "done", "cancelled"] },
    "depends_on": { "type": "array", "items": { "type": "string" } },
    "blocks": { "type": "array", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "definition_of_done": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "estimated_complexity": { "enum": ["xs", "s", "m", "l", "xl"] },
    "related_features": { "type": "array", "items": { "type": "string" } },
    "related_adrs": { "type": "array", "items": { "type": "string" } },
    "related_apis": { "type": "array", "items": { "type": "string" } },
    "related_tests": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["id", "title", "description", "priority", "owner", "status", "acceptance_criteria", "definition_of_done", "estimated_complexity"],
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blueprintos.dev/schemas/feature.schema.json",
  "title": "Feature",
  "description": "Definition of a feature specification.",
  "type": "object",
  "properties": {
    "id": { "type": "string", "description": "Unique feature identifier.", "pattern": "^[a-z][a-z0-9-]+$" },
    "name": { "type": "string", "description": "Feature name.", "minLength": 1 },
    "description": { "type": "string", "description": "Feature description." },
    "status": { "type": "string", "enum": ["proposed", "in-development", "in-review", "active", "deprecated", "cancelled"] },
    "priority": { "type": "string", "enum": ["critical", "high", "medium", "low"] },
    "version": { "type": "string", "description": "Feature version.", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "owner": { "type": "string", "description": "Feature owner." },
    "requirements": { "type": "array", "description": "Feature requirements.", "items": { "type": "string" } },
    "acceptance_criteria": { "type": "array", "description": "Feature acceptance criteria.", "items": { "type": "string" } },
    "depends_on": { "type": "array", "description": "Features this feature depends on.", "items": { "type": "string" } },
    "tasks": { "type": "array", "description": "Tasks associated with this feature.", "items": { "type": "string" } }
  },
  "required": ["id", "name", "status", "priority", "version", "owner"],
  "additionalProperties": false
}
